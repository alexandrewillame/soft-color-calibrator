<Window x:Class="SoftCal.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="24,20,24,18" Width="440">
    <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
    <!-- What changes, one line each: "Brightness: 31 → 28". -->
    <ItemsControl x:Name="Changes" AutomationProperties.Name="What changes">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="Note" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextDimBrush}" />
    <TextBlock x:Name="Warning" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource WarnBrush}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="OkButton" MinWidth="96" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Margin="10,0,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
