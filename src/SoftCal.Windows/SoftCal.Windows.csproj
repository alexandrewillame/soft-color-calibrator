  <ItemGroup>
    <ProjectReference Include="..\SoftCal.Core\SoftCal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SoftCal.Windows.Tests" />
  </ItemGroup>

</Project>
