<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Company>Soft Color Calibrator</Company>
    <Product>Soft Color Calibrator</Product>
    <Copyright>Copyright © 2026 Alexandre Willame. Licensed under the GNU GPL v3.</Copyright>
    <!-- The version of every app, PC, Android and iOS: three numbers (Google Play's version code and the App Store's
         build number are made from them). Raise it before each release. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
</Project>
